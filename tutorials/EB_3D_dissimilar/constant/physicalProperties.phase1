FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.phase1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

viscosityModel  constant;

// Metal A: 316L stainless steel, x < 0
// Representative high-temperature values; replace them with data for the
// alloys of interest.

viscosityModel  constant;

// Kinematic viscosity of the liquid [m^2/s]
nu              7.6e-07;

// Density [kg/m^3]
rho             7900;


// beamWeldFoam thermal properties

// Liquid specific heat capacity [J/kg/K]
cp              790;

// Solid specific heat capacity [J/kg/K]
cpsolid         600;

// Liquid thermal conductivity [W/m/K]
kappa           30.0;

// Solid thermal conductivity [W/m/K]
kappasolid      25.0;

// Solidus temperature [K]
Tsolidus        1658;

// Liquidus temperature [K]
Tliquidus       1723;

// Latent heat of fusion [J/kg]
LatentHeat      270000;

// Thermal expansion coefficient [1/K]
beta            1.8e-5;

// ************************************************************************* //
