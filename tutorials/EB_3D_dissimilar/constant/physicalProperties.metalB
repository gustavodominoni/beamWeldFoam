FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.metalB;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

viscosityModel  constant;

// Metal B: low-carbon steel, x > 0, the volume fraction of which is
// alpha.metalB. The presence of this file enables the second metal.
// Representative high-temperature values; replace them with data for the
// alloys of interest.

// Kinematic viscosity of the liquid [m^2/s]
nu              7.6e-07;

// Density [kg/m^3]
rho             7850;

// Liquid specific heat capacity [J/kg/K]
cp              820;

// Solid specific heat capacity [J/kg/K]
cpsolid         650;

// Liquid thermal conductivity [W/m/K]
kappa           30.0;

// Solid thermal conductivity [W/m/K]
kappasolid      35.0;

// Solidus temperature [K]
Tsolidus        1768;

// Liquidus temperature [K]
Tliquidus       1798;

// Latent heat of fusion [J/kg]
LatentHeat      270000;

// Thermal expansion coefficient [1/K]
beta            1.4e-5;


// Optional vapourisation and surface properties of metal B. If omitted, those
// of metal A in constant/phaseProperties are used.

// Vapourisation temperature [K]
Tvap            3134.0;

// Molar mass [kg/mol]
Mm              0.0558;

// Latent heat of vapourisation [J/kg]
LatentHeatVap   6.09e6;

// Surface tension [N/m]
sigma           1.9;

// Temperature coefficient of surface tension [N/m/K]
dsigmadT        -3.5e-4;

// ************************************************************************* //
