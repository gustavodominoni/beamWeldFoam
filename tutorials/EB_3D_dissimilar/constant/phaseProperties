FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (phase1 phase2);

// Surface tension of metal A [N/m]
sigma           1.8;


// beamWeldFoam interface and vapourisation properties of metal A (316L),
// representative values; those of metal B are set in
// physicalProperties.metalB

// Temperature coefficient of surface tension [N/m/K]
dsigmadT        -4.3e-4;

// Atmospheric pressure [Pa]
p0              100000.0;

// Vapourisation temperature [K]
Tvap            3090.0;

// Molar mass [kg/mol]
Mm              0.0558;

// Latent heat of vapourisation [J/kg]
LatentHeatVap   6.1e6;

