FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          beamWeldFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.12;  // the beam leaves the domain

deltaT          1.0e-12;

writeControl    adjustableRunTime;

writeInterval   1.0e-3;

purgeWrite      0;

writeFormat     binary;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.2;
maxAlphaCo      0.1;

maxDeltaT       4e-7;


// ************************************************************************* //
