FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.phase2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

viscosityModel  constant;

nu              1.48e-05;

rho             1;


// beamWeldFoam thermal properties

// Liquid specific heat capacity [J/kg/K]
cp              1000;

// Liquid thermal conductivity [W/m/K]
kappa           1.0;

// Solidus temperature [K]
Tsolidus        1.0;

// Liquidus temperature [K]
Tliquidus       10.0;

// Latent heat of fusion [J/kg]
LatentHeat      1.0;

// Thermal expansion coefficient [1/K]
beta            5.0e-4;

// ************************************************************************* //
