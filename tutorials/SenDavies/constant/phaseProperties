FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (phase1 phase2);

sigma           0.0025;


// beamWeldFoam interface and vapourisation properties

// Temperature coefficient of surface tension [N/m/K]
dsigmadT        -9.8e-05;

// Atmospheric pressure [Pa]
p0              100000.0;

// Vapourisation temperature [K]
Tvap            300000.0;

// Molar mass [kg/mol]
Mm              0.05;

// Latent heat of vapourisation [J/kg]
LatentHeatVap   6000000.0;

